# Provider switching: local or api
STT_PROVIDER=local
LLM_PROVIDER=local
TTS_PROVIDER=local

# Whisper (local)
WHISPER_MODEL_DIR=models/stt/faster-whisper-large-v3

# Piper (local)
PIPER_VOICE=models/tts/ja_JP-nanami-medium.onnx
PIPER_SAMPLERATE=22050

# VOICEVOX (api)
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=1

# OpenAI (api)
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o
OPENAI_TTS_VOICE=nova
OPENAI_TTS_FORMAT=opus

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b

# Overlay
OVERLAY_HOST=0.0.0.0
OVERLAY_PORT=5173

# Brain
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000